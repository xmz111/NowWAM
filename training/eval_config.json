{
  "backbone": "klein",
  "double_blocks": 5,
  "single_blocks": 10,
  "action_dim": 7,
  "proprio_dim": 8,
  "action_hidden_dim": 1024,
  "action_regression": true,
  "num_inference_steps": 1,
  "action_horizon": 16,
  "replan_steps": 12,
  "wait_steps": 30,
  "env_seed": 0,
  "global_seed": 42,
  "renderer": "osmesa",
  "qwen_context_len": 128,
  "qwen_thinking": false,
  "qwen_hidden_layers": [
    9,
    18,
    27
  ],
  "action_noise_rng": "torch.Generator(cpu)",
  "action_noise_seed": "control_step_after_warmup",
  "normalization": "training_minmax",
  "dift_tshift": 0.25,
  "jax_n2f_exact": true,
  "jax_fp32_residual": true,
  "jax_naive_attention": true,
  "jax_strict_mix_precision": true,
  "jax_strict_action_precision": true,
  "format": "nowwam_torch_state_dict",
  "dtype": "bfloat16",
  "text_encoder": "Qwen/Qwen3-4B",
  "online_text_encoding": true,
  "fast_render": true,
  "fast_render_sensor_noise": false,
  "mujoco": "3.3.2",
  "robosuite": "1.4.0",
  "mesa": "24.3.4",
  "binarize_gripper": true
}
